{
  "name": "browser-2d-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.5.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev/dev.mjs",
    "dev:ui": "node scripts/dev/dev-ui.mjs",
    "dev:backend": "node scripts/dev/dev.mjs --backend-only",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:boundaries",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint apps packages internal tests/e2e",
    "typecheck": "pnpm -r --if-present typecheck && tsc --noEmit -p tests/e2e/tsconfig.json",
    "test": "vitest run",
    "test:storage": "pnpm --filter @browser-2d/backend test:storage",
    "test:credentials": "pnpm --filter @browser-2d/desktop test:credentials",
    "test:electron": "node scripts/testing/electron-test.mjs",
    "test:e2e": "node scripts/testing/electron-test.mjs",
    "build": "pnpm --filter @browser-2d/backend build && pnpm --filter @browser-2d/desktop build && node scripts/checks/check-artifacts.mjs",
    "package": "node scripts/packaging/package.mjs",
    "dist": "node scripts/packaging/package.mjs --dist",
    "verify:package": "node scripts/packaging/verify-package.mjs",
    "verify:formats": "node scripts/packaging/verify-formats.mjs",
    "verify": "pnpm check && pnpm test:workflows && pnpm test && pnpm test:storage && pnpm test:credentials && pnpm test:updates && pnpm test:release && pnpm test:process && pnpm test:electron",
    "check:boundaries": "node scripts/checks/check-boundaries.mjs && node --test scripts/checks/check-boundaries.test.mjs && node scripts/checks/script-paths.mjs",
    "test:updates": "pnpm --filter @browser-2d/desktop test:updates",
    "test:release": "node --test scripts/release/release.test.mjs",
    "verify:installation": "node scripts/packaging/verify-installation.mjs",
    "release:verify": "node scripts/release/release-verify.mjs",
    "release:prepare": "node scripts/release/release-prepare.mjs",
    "release": "node scripts/release/release-publish.mjs",
    "test:workflows": "node --test scripts/testing/workflows.test.mjs",
    "test:process": "node scripts/testing/test-process.mjs",
    "test:adspower": "node scripts/testing/test-adspower.mjs",
    "test:platform": "pnpm --filter @browser-2d/desktop test:platform"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@playwright/test": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "prettier": "catalog:",
    "eslint": "catalog:",
    "@eslint/js": "catalog:",
    "typescript-eslint": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "@types/node": "catalog:",
    "jsdom": "catalog:",
    "@electron/asar": "catalog:",
    "yaml": "catalog:"
  }
}
