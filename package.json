{
  "name": "browser-2d-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.5.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "node scripts/dev-ui.mjs",
    "dev:worker": "node scripts/dev.mjs --worker-only",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:boundaries",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint apps packages internal tests/e2e",
    "typecheck": "pnpm -r --if-present typecheck && tsc --noEmit -p tests/e2e/tsconfig.json",
    "test": "vitest run",
    "test:storage": "pnpm --filter @browser-2d/worker-runtime test:storage",
    "test:electron": "node scripts/electron-test.mjs",
    "test:e2e": "node scripts/electron-test.mjs",
    "build": "pnpm --filter @browser-2d/worker-runtime build && pnpm --filter @browser-2d/desktop build && node scripts/check-artifacts.mjs",
    "package": "node scripts/package.mjs",
    "dist": "node scripts/package.mjs --dist",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "pnpm check && pnpm test && pnpm test:storage && pnpm test:electron",
    "check:boundaries": "node scripts/check-boundaries.mjs && node --test scripts/check-boundaries.test.mjs"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@playwright/test": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "prettier": "catalog:",
    "eslint": "catalog:",
    "@eslint/js": "catalog:",
    "typescript-eslint": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "@types/node": "catalog:",
    "jsdom": "catalog:",
    "@browser-2d/lint-config": "workspace:*",
    "@browser-2d/test-utils": "workspace:*",
    "@electron/asar": "catalog:"
  }
}
